# PostgreSQL
# Local Homebrew Postgres (default):
DATABASE_URL="postgresql://noteshare:noteshare@localhost:5432/noteshare?schema=public"
# Or docker-compose (maps host 5433 -> container 5432):
# DATABASE_URL="postgresql://noteshare:noteshare@localhost:5433/noteshare?schema=public"

# JWT signing secret — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Public origin of the frontend (used when building share URLs)
WEB_ORIGIN="http://localhost:3000"

# API listen port
PORT=4000

# CORS origin (frontend)
CORS_ORIGIN="http://localhost:3000"

# Supabase Storage (rich-text media) — private bucket `note-media`
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # server only — never expose to the browser
# MEDIA_BUCKET="note-media"
# MEDIA_MAX_BYTES_PER_FILE=3145728    # 3 MB
# MEDIA_MAX_BYTES_PER_USER=41943040   # 40 MB
# MEDIA_SIGNED_URL_TTL_SEC=3600
