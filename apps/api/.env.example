# PostgreSQL
# Local Homebrew Postgres (default):
DATABASE_URL="postgresql://noteshare:noteshare@localhost:5432/noteshare?schema=public"
# Or docker-compose (maps host 5433 -> container 5432):
# DATABASE_URL="postgresql://noteshare:noteshare@localhost:5433/noteshare?schema=public"

# JWT signing secret — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Public origin of the frontend (used when building share URLs)
WEB_ORIGIN="http://localhost:3000"

# API listen port
PORT=4000

# CORS origin (frontend)
CORS_ORIGIN="http://localhost:3000"
